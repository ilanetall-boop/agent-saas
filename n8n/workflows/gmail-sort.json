{
  "name": "Gmail - Trier les mails",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "gmail-sort",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "getAll",
        "returnAll": false,
        "limit": 50,
        "filters": {
          "labelIds": ["INBOX"],
          "includeSpamTrash": false
        },
        "options": {}
      },
      "id": "gmail-1",
      "name": "Gmail - Lire mails",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [450, 300],
      "credentials": {
        "gmailOAuth2": {
          "id": "{{GMAIL_CREDENTIAL_ID}}",
          "name": "Gmail OAuth"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json[\"labelIds\"]}}",
              "operation": "contains",
              "value2": "IMPORTANT"
            }
          ]
        }
      },
      "id": "filter-1",
      "name": "Filtrer importants",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: true, processed: $json.length, message: 'Mails triés avec succès' } }}"
      },
      "id": "response-1",
      "name": "Réponse",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [850, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Gmail - Lire mails",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gmail - Lire mails": {
      "main": [
        [
          {
            "node": "Filtrer importants",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filtrer importants": {
      "main": [
        [
          {
            "node": "Réponse",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": ["eva", "gmail", "email"]
}
